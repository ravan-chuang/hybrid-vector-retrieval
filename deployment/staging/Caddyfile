{
	admin off
	skip_install_trust
	auto_https disable_redirects
}

https://localhost:8443 {
	tls internal

	route {
		@internal path /api/internal /api/internal/* /api/docs /api/docs/* /api/redoc /api/redoc/* /api/openapi.json
		respond @internal 404

		basic_auth {
			{$STAGING_USER} {$STAGING_PASSWORD_HASH}
		}

		header {
			Cache-Control "no-store"
			X-Content-Type-Options "nosniff"
		}

		handle_path /api/* {
			reverse_proxy {$STAGING_BACKEND} {
				header_up -Authorization
				header_up X-Staging-Proxy-Token {$STAGING_PROXY_TOKEN}
				transport http {
					dial_timeout 3s
					response_header_timeout 10s
				}
			}
		}

		handle {
			root * /srv/current
			file_server
		}
	}
}
